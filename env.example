# cp .env.example .env.local, then fill in your Supabase project values
# (Project Settings > API in the Supabase dashboard)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Leave both blank / unset to run the app in DEMO mode against the bundled
# mock data (src/data/mockData.js) — useful for design review without a
# real backend.

# AI 자동 보완 기능 사용 여부. false(기본값)로 두면 "AI 자동 보완" 버튼이
# 화면에서 숨겨지고, Anthropic API 키/과금 없이 나머지 기능(타임시트 저장,
# 제출, 팀장 승인/피드백)만 그대로 사용할 수 있습니다.
# 나중에 Anthropic API 키를 발급받아 Supabase에 ai-enhance 함수를 배포한 뒤,
# 이 값만 true로 바꾸면 코드 수정 없이 AI 기능이 켜집니다.
VITE_AI_ENABLED=false
